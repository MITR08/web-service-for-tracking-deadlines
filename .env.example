# =============================================================================
# Шаблон конфигурации окружения (.env.example)
# Скопируйте этот файл в .env перед запуском: cp .env.example .env
# =============================================================================

# --- Общие настройки приложения ---
PROJECT_NAME="Веб-сервис для учёта заданий и дедлайнов учебной группы"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- PostgreSQL 15+ ---
POSTGRES_USER=deadline_user
POSTGRES_PASSWORD=deadline_secret_password
POSTGRES_DB=deadline_tracker_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://deadline_user:deadline_secret_password@db:5432/deadline_tracker_db

# --- Redis (брутфорс-счётчики, сессии, Rate Limiting) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- JWT и безопасность (п. 4.2.1, 4.2.2, 4.15.2 ТЗ) ---
JWT_SECRET_KEY=change_this_super_secret_jwt_key_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Пороги защиты от перебора паролей (п. 4.2.2 ТЗ)
BRUTEFORCE_WINDOW_SECONDS=900
BRUTEFORCE_CAPTCHA_THRESHOLD=5
BRUTEFORCE_LOCKOUT_THRESHOLD=10
BRUTEFORCE_LOCKOUT_DURATION_SECONDS=900
BRUTEFORCE_IP_THRESHOLD=20

# --- Объектное хранилище файлов S3 / MinIO (п. 4.11 ТЗ) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secret
S3_BUCKET_NAME=study-materials-and-reports
MAX_UPLOAD_SIZE_MB=50
MAX_ARCHIVE_UNPACKED_SIZE_MB=200
MAX_ARCHIVE_NESTING_LEVEL=2

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
